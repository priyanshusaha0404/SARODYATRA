<NamedLayer><Name>pujox_zones</Name><UserStyle><Title>Puja zones</Title><FeatureTypeStyle>
 <Rule><Name>North</Name><Title>North Kolkata</Title><ogc:Filter><ogc:PropertyIsEqualTo><ogc:PropertyName>zone</ogc:PropertyName><ogc:Literal>North</ogc:Literal></ogc:PropertyIsEqualTo></ogc:Filter><PolygonSymbolizer><Fill><CssParameter name="fill">#C8102E</CssParameter><CssParameter name="fill-opacity">0.07</CssParameter></Fill><Stroke><CssParameter name="stroke">#C8102E</CssParameter><CssParameter name="stroke-width">1.6</CssParameter><CssParameter name="stroke-dasharray">8 6</CssParameter></Stroke></PolygonSymbolizer><TextSymbolizer><Label><ogc:PropertyName>zone</ogc:PropertyName></Label><Font><CssParameter name="font-family">Serif</CssParameter><CssParameter name="font-size">16</CssParameter><CssParameter name="font-weight">bold</CssParameter></Font><Halo><Radius>2</Radius><Fill><CssParameter name="fill">#FFFFFF</CssParameter></Fill></Halo><Fill><CssParameter name="fill">#C8102E</CssParameter></Fill></TextSymbolizer></Rule>
